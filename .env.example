# ============================================================================
# Reagentic Banking Agent — environment (COPY to .env, do NOT commit)
# All values below are defaults for the local "homelab" deployment.
# For Azure for Students, override the *_{DB_URL,KAFKA_BOOTSTRAP_SERVERS}*
# vars (and JWT secret) with the Azure-managed equivalents — no code change.
# ============================================================================

# ---- Shared JWT (every service signs/verifies with this; >=32 bytes) --------
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes-long-please
JWT_TTL_MS=86400000

# ---- Service discovery (compose service names; localhost:port when bare) -----
AUTH_SERVICE_URL=http://auth-service:8081
ACCOUNT_SERVICE_URL=http://account-service:8082
PAYMENT_SERVICE_URL=http://payment-service:8083
LEDGER_SERVICE_URL=http://ledger-service:8084
NOTIFICATION_SERVICE_URL=http://notification-service:8085
AI_AGENT_URL=http://ai-agent:8086

# ---- Databases (env-driven: local compose OR Aiven/Neon/Azure Postgres) -----
# Default = local compose Postgres containers. To use a cloud DB, just set
# the *_DB_URL (and *_DB_USERNAME/PASSWORD if different).
AUTH_DB_URL=jdbc:postgresql://auth-db:5432/auth
ACCOUNT_DB_URL=jdbc:postgresql://account-db:5432/account
PAYMENT_DB_URL=jdbc:postgresql://payment-db:5432/payment
LEDGER_DB_URL=jdbc:postgresql://ledger-db:5432/ledger
NOTIFICATION_DB_URL=jdbc:postgresql://notification-db:5432/notification

# Shared local Postgres credentials (compose + Flyway)
POSTGRES_USER=reagentic
POSTGRES_PASSWORD=reagentic
SPRING_DATASOURCE_USERNAME=reagentic
SPRING_DATASOURCE_PASSWORD=reagentic

# ---- Kafka (immutable audit log) --------------------------------------------
# Default = local KRaft container. Set to Aiven/Azure Event Hubs (Kafka) here.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ---- Agent / LLM ------------------------------------------------------------
# Local Ollama default. In compose, Ollama runs on the host -> host.docker.internal.
SPRING_AI_OLLAMA_BASE_URL=http://host.docker.internal:11434
# Deterministic heuristic fallback is ALWAYS on if structured LLM output fails.
# Optional cloud LLM (env-gated, no cost unless a key is set):
SPRING_AI_OPENAI_API_KEY=

# ---- Ledger hero "break" toggle (reproducible reconcile demo) ---------------
LEDGER_FAULT_SKIP_APPEND=false

# ---- Cloudflare edge (worker/ fetches this tunneled gateway) ----------------
GATEWAY_URL=http://gateway:8080
VITE_GATEWAY_URL=http://localhost:8080
