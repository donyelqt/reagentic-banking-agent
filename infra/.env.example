# Copy to infra/.env and adjust. NEVER commit the real .env (git-ignored).
# JWT secret must be >= 32 bytes for HS256.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes

POSTGRES_USER=reagentic
POSTGRES_PASSWORD=reagentic
SPRING_DATASOURCE_USERNAME=reagentic
SPRING_DATASOURCE_PASSWORD=reagentic

KAFKA_BOOTSTRAP_SERVERS=kafka:9092

AUTH_DB_URL=jdbc:postgresql://postgres:5432/auth
ACCOUNT_DB_URL=jdbc:postgresql://postgres:5432/account
PAYMENT_DB_URL=jdbc:postgresql://postgres:5432/payment
LEDGER_DB_URL=jdbc:postgresql://postgres:5432/ledger
NOTIFICATION_DB_URL=jdbc:postgresql://postgres:5432/notification

AUTH_SERVICE_URL=http://auth-service:8081
ACCOUNT_SERVICE_URL=http://account-service:8082
PAYMENT_SERVICE_URL=http://payment-service:8083
LEDGER_SERVICE_URL=http://ledger-service:8084
NOTIFICATION_SERVICE_URL=http://notification-service:8085
AI_AGENT_URL=http://ai-agent:8086

VITE_GATEWAY_URL=http://localhost:8080

# Optional: LLM provider for the agent (gemini | ollama). Leave AGENT_GEMINI_API_KEY
# blank to force the deterministic keyword fallback (demo still works with no LLM).
AGENT_PROVIDER=gemini
# Gemini (default primary): set your Google AI Studio API key. Wired through
# Spring AI's google-genai starter (spring.ai.google.genai.*).
AGENT_GEMINI_API_KEY=
AGENT_GEMINI_MODEL=gemini-2.5-flash
# Ollama: switch AGENT_PROVIDER=ollama to use local Ollama instead.
# (SPRING_AI_OLLAMA_* below are real Spring AI properties - do NOT rename.)
SPRING_AI_OLLAMA_BASE_URL=http://host.docker.internal:11434

# Demo fault injection: when true, ledger consumes payment events but skips the
# append (the "missing leg" break). Enabled on demand for the hero reconcile.
LEDGER_FAULT_SKIP_APPEND=false
